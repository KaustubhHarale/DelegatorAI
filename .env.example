DATABASE_PATH=delegatorai.db

# NVIDIA API configuration for GPT-OSS-20B
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# Slack app credentials. Never put these in VITE_* variables.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional bot user ID, used to ignore its own messages and detect mentions.
SLACK_BOT_USER_ID=
# JSON object mapping Slack channel IDs to project IDs.
# Example: {"C0123456789":"college-app"}
SLACK_PROJECT_CHANNELS={}
# Slack user IDs allowed to use `link`, `create`, and `delegate` message commands.
SLACK_ADMIN_USER_IDS=

# Frontend development server API target
VITE_API_BASE_URL=http://localhost:8000
